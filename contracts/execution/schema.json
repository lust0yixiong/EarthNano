{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EarthNano Execution Contract v1",
  "definitions": {
    "Ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "additionalProperties": false
    },
    "ExecutionRole": {
      "type": "string",
      "enum": [
        "task",
        "baseline",
        "candidate",
        "proposer",
        "composer",
        "selector",
        "reflection",
        "reviewer"
      ]
    },
    "ExecutionPhase": {
      "type": "string",
      "enum": [
        "queued",
        "preparing",
        "running",
        "completed",
        "failed",
        "cancelled",
        "interrupted"
      ]
    },
    "CleanupState": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "unknown"
      ]
    },
    "ExecutionOrigin": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "interactive",
            "automation",
            "optimization"
          ]
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "promptMessageId": {
          "type": "string",
          "minLength": 1
        },
        "optimizationId": {
          "type": "string",
          "minLength": 1
        },
        "stageId": {
          "type": "string",
          "minLength": 1
        },
        "parentExecutionId": {
          "type": "string",
          "minLength": 1
        },
        "retryOfExecutionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "ExecutionRequest": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "type": "integer",
          "const": 1
        },
        "requestKey": {
          "type": "string",
          "minLength": 1
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "taskSnapshotRef": {
          "$ref": "#/definitions/Ref"
        },
        "invocationRef": {
          "$ref": "#/definitions/Ref"
        },
        "agentSpecRef": {
          "$ref": "#/definitions/Ref"
        },
        "harnessRevisionRef": {
          "$ref": "#/definitions/Ref"
        },
        "environmentSpecRef": {
          "$ref": "#/definitions/Ref"
        },
        "role": {
          "$ref": "#/definitions/ExecutionRole"
        },
        "origin": {
          "$ref": "#/definitions/ExecutionOrigin"
        },
        "interactionPolicy": {
          "type": "string",
          "enum": [
            "interactive",
            "deny-unresolved"
          ]
        },
        "budgetRef": {
          "type": "string",
          "minLength": 1
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "contractVersion",
        "requestKey",
        "projectId",
        "taskSnapshotRef",
        "invocationRef",
        "agentSpecRef",
        "harnessRevisionRef",
        "environmentSpecRef",
        "role",
        "origin",
        "interactionPolicy",
        "budgetRef",
        "timeoutMs"
      ],
      "additionalProperties": false
    },
    "ExecutionIdentity": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "promptMessageId": {
          "type": "string",
          "minLength": 1
        },
        "providerSessionId": {
          "type": "string",
          "minLength": 1
        },
        "promptAttemptId": {
          "type": "string",
          "minLength": 1
        },
        "runtimeExecutionId": {
          "type": "string",
          "minLength": 1
        },
        "turnToken": {
          "type": "string",
          "minLength": 1
        },
        "promptExecutionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ArtifactReference": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "versionId": {
          "type": "string",
          "minLength": 1
        },
        "checksum": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "artifactId",
        "versionId",
        "checksum"
      ],
      "additionalProperties": false
    },
    "ExecutionEvidence": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ArtifactReference"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Ref"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "scope",
        "text",
        "artifacts",
        "references",
        "limitations"
      ],
      "additionalProperties": false
    },
    "ExecutionUsage": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "known",
            "unknown"
          ]
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "costMicrousd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "EffectiveConfiguration": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "unknown"
          ]
        },
        "requestedDigest": {
          "type": "string",
          "minLength": 1
        },
        "materializedDigest": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "runtimeVersion": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confirmation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "requestedDigest",
        "instructions",
        "skills",
        "tools",
        "confirmation"
      ],
      "additionalProperties": false
    },
    "ExecutionError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "ExecutionHandle": {
      "type": "object",
      "properties": {
        "executionId": {
          "type": "string",
          "minLength": 1
        },
        "requestKey": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "$ref": "#/definitions/ExecutionPhase"
        },
        "identity": {
          "$ref": "#/definitions/ExecutionIdentity"
        }
      },
      "required": [
        "executionId",
        "requestKey",
        "phase",
        "identity"
      ],
      "additionalProperties": false
    },
    "ExecutionRecord": {
      "type": "object",
      "properties": {
        "executionId": {
          "type": "string",
          "minLength": 1
        },
        "requestKey": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "$ref": "#/definitions/ExecutionPhase"
        },
        "identity": {
          "$ref": "#/definitions/ExecutionIdentity"
        },
        "request": {
          "$ref": "#/definitions/ExecutionRequest"
        },
        "requestDigest": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "type": "string",
          "minLength": 1
        },
        "cleanup": {
          "$ref": "#/definitions/CleanupState"
        },
        "cancellationRequested": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/definitions/ExecutionEvidence"
        },
        "usage": {
          "$ref": "#/definitions/ExecutionUsage"
        },
        "configuration": {
          "$ref": "#/definitions/EffectiveConfiguration"
        },
        "error": {
          "$ref": "#/definitions/ExecutionError"
        }
      },
      "required": [
        "executionId",
        "requestKey",
        "phase",
        "identity",
        "request",
        "requestDigest",
        "createdAt",
        "updatedAt",
        "cleanup",
        "cancellationRequested",
        "evidence",
        "usage",
        "configuration"
      ],
      "additionalProperties": false
    },
    "ExecutionEvent": {
      "type": "object",
      "properties": {
        "executionId": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "enum": [
            "phase",
            "identity",
            "provider-accepted",
            "session-admitted",
            "evidence",
            "gap"
          ]
        },
        "time": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "$ref": "#/definitions/ExecutionPhase"
        },
        "identity": {
          "$ref": "#/definitions/ExecutionIdentity"
        },
        "evidence": {
          "$ref": "#/definitions/ExecutionEvidence"
        },
        "gapAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "executionId",
        "sequence",
        "type",
        "time"
      ],
      "additionalProperties": false
    },
    "CancellationReceipt": {
      "type": "object",
      "properties": {
        "executionId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "requested",
            "cancelled",
            "already-terminal"
          ]
        },
        "cleanup": {
          "$ref": "#/definitions/CleanupState"
        }
      },
      "required": [
        "executionId",
        "status",
        "cleanup"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/definitions/ExecutionRequest"
}
